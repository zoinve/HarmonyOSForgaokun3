# Publication is an allowlist. All local media, images and evidence stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/docs/
!/tools/
!/.github/
!/next-experiment/
!/reports/

/next-experiment/*
!/next-experiment/*.py
!/next-experiment/*.c
!/next-experiment/*.cpp
!/next-experiment/*.h
!/next-experiment/*.hpp
!/next-experiment/*.service
!/next-experiment/*.timer

/reports/*
!/reports/*.md

/docs/**
!/docs/**/
!/docs/**/*.md
/tools/*
!/tools/*.py
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/source-only.yml

# Defense in depth, even inside otherwise included directories.
**/__pycache__/
*.pyc
*.img
*.iso
*.qcow2
*.raw
*.ext4
*.sbit
*.bin
*.dtb
*.dtbo
*.efi
*.so
*.so.*
*.a
*.o
*.dll
*.exe
*.gz
*.xz
*.zip
*.tar
*.7z
*.png
*.jpg
*.ppm
*.log
*.stdout
*.stderr

# Original Linux compatibility launcher uses memory.limit_in_bytes (cgroup v1).
CONFIG_MEMCG_V1=y
# Create PMIC PWRKEY/RESIN children without userspace module autoload.
CONFIG_REBOOT_MODE=y
CONFIG_POWER_RESET_QCOM_PON=y
# Let builtin qcom-cpufreq-hw resolve its CPU interconnect paths at boot.
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
